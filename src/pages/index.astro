---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome">
  <div class="max-w-3xl mx-auto">
    <!-- Welcome Section -->
    <div class="mb-8 sm:mb-12">
      <span class="inline-block px-3 py-1.5 sm:px-4 sm:py-2 bg-warm-100 text-coral rounded-full text-xs sm:text-sm font-medium mb-4 sm:mb-6">
        Your Pregnancy Journey
      </span>
      
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-forest mb-4 sm:mb-6 leading-tight">
        The Guide on What to Expect During Pregnancy
      </h1>
      
      <p class="text-base sm:text-lg lg:text-xl text-gray-600 leading-relaxed">
        Our guide provides you with information on how your pregnancy will be month by month, 
        including the changes in your body, the growth of your baby, and how to take care of yourself.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mb-8 sm:mb-12">
      <div class="card card-pink">
        <div class="text-2xl sm:text-3xl mb-2 sm:mb-3">👶</div>
        <h3 class="font-display text-base sm:text-lg font-semibold text-gray-800 mb-1 sm:mb-2">Baby's Development</h3>
        <p class="text-gray-600 text-xs sm:text-sm">
          Track your baby's growth from a tiny seed to a full-term newborn, week by week.
        </p>
      </div>
      
      <div class="card card-green">
        <div class="text-2xl sm:text-3xl mb-2 sm:mb-3">🤰</div>
        <h3 class="font-display text-base sm:text-lg font-semibold text-gray-800 mb-1 sm:mb-2">Body Changes</h3>
        <p class="text-gray-600 text-xs sm:text-sm">
          Understand the incredible changes happening in your body throughout pregnancy.
        </p>
      </div>
      
      <div class="card card-blue">
        <div class="text-2xl sm:text-3xl mb-2 sm:mb-3">🏥</div>
        <h3 class="font-display text-base sm:text-lg font-semibold text-gray-800 mb-1 sm:mb-2">Medical Guidance</h3>
        <p class="text-gray-600 text-xs sm:text-sm">
          Know what tests and check-ups to expect at each stage of your pregnancy.
        </p>
      </div>
      
      <div class="card card-peach">
        <div class="text-2xl sm:text-3xl mb-2 sm:mb-3">💚</div>
        <h3 class="font-display text-base sm:text-lg font-semibold text-gray-800 mb-1 sm:mb-2">Wellness Tips</h3>
        <p class="text-gray-600 text-xs sm:text-sm">
          Learn how to take care of yourself and stay healthy for you and your baby.
        </p>
      </div>
    </div>

    <!-- Journey Overview -->
    <div class="bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-sm mb-8 sm:mb-12">
      <h2 class="font-display text-xl sm:text-2xl font-semibold text-forest mb-4 sm:mb-6">Your 9-Month Journey</h2>
      
      <div class="space-y-4 sm:space-y-6">
        <!-- First Trimester -->
        <div class="flex flex-col sm:flex-row gap-2 sm:gap-4">
          <div class="flex-shrink-0">
            <span class="inline-block px-3 py-1 bg-pink-100 text-pink-700 rounded-full text-xs font-medium">
              Months 1-3
            </span>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">First Trimester</h3>
            <p class="text-gray-600 text-sm">
              The beginning of life. Your baby's organs form, and you may experience morning sickness and fatigue.
            </p>
          </div>
        </div>
        
        <!-- Second Trimester -->
        <div class="flex flex-col sm:flex-row gap-2 sm:gap-4">
          <div class="flex-shrink-0">
            <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full text-xs font-medium">
              Months 4-6
            </span>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">Second Trimester</h3>
            <p class="text-gray-600 text-sm">
              The golden period! Energy returns, baby bump shows, and you'll feel those first magical kicks.
            </p>
          </div>
        </div>
        
        <!-- Third Trimester -->
        <div class="flex flex-col sm:flex-row gap-2 sm:gap-4">
          <div class="flex-shrink-0">
            <span class="inline-block px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-medium">
              Months 7-9
            </span>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">Third Trimester</h3>
            <p class="text-gray-600 text-sm">
              The home stretch! Your baby gains weight, settles into position, and prepares to meet you.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="text-center">
      <a 
        href="/month/1"
        class="inline-flex items-center gap-2 bg-forest text-white px-6 py-3 sm:px-8 sm:py-4 rounded-full font-semibold hover:bg-opacity-90 transition-all hover:shadow-lg hover:-translate-y-0.5 text-sm sm:text-base"
      >
        Start Your Journey
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <p class="text-gray-400 text-xs sm:text-sm mt-3 sm:mt-4">
        <span class="hidden sm:inline">Select a month from the sidebar to begin</span>
        <span class="sm:hidden">Tap the menu to explore months</span>
      </p>
    </div>
  </div>
</Layout>
