---
import type { GetStaticPaths } from 'astro';
import Layout from '@layouts/Layout.astro';
import { monthsData } from '@data/months';

export const getStaticPaths = (() => {
  return monthsData.map((month) => ({
    params: { month: month.number.toString() },
    props: { data: month },
  }));
}) satisfies GetStaticPaths;

interface Props {
  data: typeof monthsData[number];
}

const { data } = Astro.props;
const prevMonth = data.number > 1 ? data.number - 1 : null;
const nextMonth = data.number < 9 ? data.number + 1 : null;
---

<Layout title={`Month ${data.number}: ${data.title}`} currentMonth={data.number}>
  <div class="max-w-4xl mx-auto pb-24 sm:pb-0">
    <!-- Navigation Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 sm:mb-8">
      <a 
        href="/"
        class="inline-flex items-center gap-2 px-3 py-2 sm:px-4 sm:py-2 bg-white rounded-full shadow-sm sm:hover:shadow-md transition-all text-gray-700 hover:text-forest text-sm self-start"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span class="hidden sm:inline">Back to Guide</span>
        <span class="sm:hidden">Home</span>
      </a>
      
      <div class="flex items-center gap-1 sm:gap-2">
        {prevMonth ? (
          <a 
            href={`/month/${prevMonth}`}
            class="inline-flex items-center gap-1 px-2 py-1.5 sm:px-4 sm:py-2 bg-white rounded-full shadow-sm sm:hover:shadow-md transition-all text-gray-700 hover:text-forest text-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span class="hidden sm:inline">Previous</span>
          </a>
        ) : (
          <span class="px-2 py-1.5 sm:px-4 sm:py-2 text-gray-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </span>
        )}
        
        <span class="text-sm text-gray-400 px-2">
          {data.number} / 9
        </span>
        
        {nextMonth ? (
          <a 
            href={`/month/${nextMonth}`}
            class="inline-flex items-center gap-1 px-2 py-1.5 sm:px-4 sm:py-2 bg-white rounded-full shadow-sm sm:hover:shadow-md transition-all text-gray-700 hover:text-forest text-sm"
          >
            <span class="hidden sm:inline">Next</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : (
          <span class="px-2 py-1.5 sm:px-4 sm:py-2 bg-coral text-white rounded-full font-medium text-xs sm:text-sm">
            <span class="hidden sm:inline">Ready for Baby!</span> 🎉
          </span>
        )}
      </div>
    </div>

    <!-- Month Header -->
    <div class="mb-6 sm:mb-10">
      <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-gray-500 uppercase tracking-wider mb-2">
        <span class="font-medium text-plum">{data.trimester}</span>
        <span>•</span>
        <span>{data.weeks}</span>
      </div>
      <h1 class="font-display text-2xl sm:text-4xl lg:text-5xl font-bold text-gray-900" transition:name={`month-title-${data.number}`}>
        Month {data.number}: {data.title}
      </h1>
    </div>

    <!-- Baby's Development & Body Changes Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-4 sm:mb-6">
      <!-- Baby's Development -->
      <div class="card card-pink">
        <h2 class="font-display text-lg sm:text-xl font-semibold text-gray-800 mb-3 sm:mb-4 flex items-center gap-2">
          <span class="text-xl sm:text-2xl">👶</span>
          Baby's Development
        </h2>
        <p class="text-gray-600 text-sm sm:text-base mb-3 sm:mb-4">{data.babyDevelopment.description}</p>
        
        <div class="space-y-1 sm:space-y-2 mb-3 sm:mb-4 text-sm sm:text-base">
          <p class="text-gray-700">
            <span class="font-semibold">Size:</span> {data.babyDevelopment.size}
          </p>
          <p class="text-gray-700">
            <span class="font-semibold">Weight:</span> {data.babyDevelopment.weight}
          </p>
        </div>
        
        <div>
          <h3 class="font-medium text-gray-800 mb-2 text-sm sm:text-base">Key Milestones:</h3>
          <ul class="space-y-1">
            {data.babyDevelopment.milestones.map((milestone) => (
              <li class="flex items-start gap-2 text-gray-600 text-xs sm:text-sm">
                <span class="text-coral mt-0.5">•</span>
                {milestone}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Your Body Changes -->
      <div class="card card-pink">
        <h2 class="font-display text-lg sm:text-xl font-semibold text-gray-800 mb-3 sm:mb-4 flex items-center gap-2">
          <span class="text-xl sm:text-2xl">🤰</span>
          Your Body Changes
        </h2>
        <p class="text-gray-600 text-sm sm:text-base mb-3 sm:mb-4">{data.bodyChanges.description}</p>
        
        <div>
          <h3 class="font-medium text-gray-800 mb-2 text-sm sm:text-base">Common Symptoms:</h3>
          <ul class="space-y-1">
            {data.bodyChanges.symptoms.map((symptom) => (
              <li class="flex items-start gap-2 text-gray-600 text-xs sm:text-sm">
                <span class="text-coral mt-0.5">•</span>
                {symptom}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Care & Wellness Tips -->
    <div class="card card-green mb-4 sm:mb-6">
      <h2 class="font-display text-lg sm:text-xl font-semibold text-gray-800 mb-3 sm:mb-4 flex items-center gap-2">
        <span class="text-xl sm:text-2xl">💚</span>
        Care & Wellness Tips
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 sm:gap-x-8 gap-y-2">
        {data.careTips.map((tip) => (
          <div class="flex items-start gap-2 text-gray-600 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 text-forest flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{tip}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Medical Checkups -->
    <div class="card card-blue mb-4 sm:mb-6">
      <h2 class="font-display text-lg sm:text-xl font-semibold text-gray-800 mb-3 sm:mb-4 flex items-center gap-2">
        <span class="text-xl sm:text-2xl">🏥</span>
        Medical Checkups
      </h2>
      <p class="text-gray-600 text-sm sm:text-base mb-3 sm:mb-4">{data.medicalCheckups.description}</p>
      <ul class="space-y-1 sm:space-y-2">
        {data.medicalCheckups.items.map((item) => (
          <li class="flex items-start gap-2 text-gray-600 text-sm">
            <span class="text-blue-500 mt-0.5">•</span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <!-- Things to Avoid -->
    <div class="card card-peach mb-4 sm:mb-6">
      <h2 class="font-display text-lg sm:text-xl font-semibold text-gray-800 mb-3 sm:mb-4 flex items-center gap-2">
        <span class="text-xl sm:text-2xl">⚠️</span>
        Things to Avoid
      </h2>
      <ul class="space-y-1 sm:space-y-2">
        {data.thingsToAvoid.map((item) => (
          <li class="flex items-start gap-2 text-gray-600 text-sm">
            <span class="text-orange-500 mt-0.5">•</span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <!-- Partner Support -->
    <div class="card bg-gradient-to-br from-purple-50 to-indigo-50 mb-4 sm:mb-6">
      <h2 class="font-display text-lg sm:text-xl font-semibold text-gray-800 mb-3 sm:mb-4 flex items-center gap-2">
        <span class="text-xl sm:text-2xl">💑</span>
        How Partners Can Help
      </h2>
      <p class="text-gray-600 text-sm sm:text-base mb-3 sm:mb-4">{data.partnerSupport.description}</p>
      <ul class="space-y-1 sm:space-y-2">
        {data.partnerSupport.tips.map((tip) => (
          <li class="flex items-start gap-2 text-gray-600 text-sm">
            <span class="text-plum mt-0.5">•</span>
            {tip}
          </li>
        ))}
      </ul>
    </div>

    <!-- Bottom Navigation - Fixed on mobile, always visible -->
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-warm-200 px-4 py-3 sm:px-0 sm:py-0 sm:static sm:border-t-0 sm:bg-transparent sm:mt-4 sm:pt-6 shadow-lg sm:shadow-none z-50">
      <div class="flex items-center justify-between max-w-4xl mx-auto">
        {prevMonth ? (
          <a 
            href={`/month/${prevMonth}`}
            class="inline-flex items-center gap-2 text-gray-500 hover:text-forest sm:hover:bg-warm-100 transition-colors px-3 py-2 rounded-lg"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <div class="text-left">
              <span class="block text-xs text-gray-400">Previous</span>
              <span class="font-medium text-sm sm:text-base">Month {prevMonth}</span>
            </div>
          </a>
        ) : (
          <div></div>
        )}
        
        {nextMonth ? (
          <a 
            href={`/month/${nextMonth}`}
            class="inline-flex items-center gap-2 text-gray-500 hover:text-forest sm:hover:bg-warm-100 transition-colors px-3 py-2 rounded-lg"
          >
            <div class="text-right">
              <span class="block text-xs text-gray-400">Next</span>
              <span class="font-medium text-sm sm:text-base">Month {nextMonth}</span>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : (
          <div class="text-right">
            <span class="block text-xs text-gray-400">Congratulations!</span>
            <span class="font-medium text-coral text-sm sm:text-base">Ready to meet your baby! 🎉</span>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
