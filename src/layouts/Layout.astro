---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  currentMonth?: number;
}

const { title, currentMonth } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A comprehensive guide to pregnancy, month by month" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Pregnancy Guide</title>
    <ViewTransitions />
  </head>
  <body class="bg-cream min-h-screen">
    <!-- Mobile Header -->
    <header class="lg:hidden fixed top-0 left-0 right-0 z-50 bg-white border-b border-warm-200 px-4 py-3" transition:persist>
      <div class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-coral to-pink-400 flex items-center justify-center">
            <span class="text-white text-lg">🤰</span>
          </div>
          <div>
            <span class="font-display text-lg font-semibold text-forest">Pregnancy</span>
            <span class="text-sm text-gray-500 ml-1">Guide</span>
          </div>
        </a>
        <button 
          id="menu-toggle"
          class="p-2 rounded-lg hover:bg-warm-100 transition-colors"
          aria-label="Toggle menu"
        >
          <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-forest" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-forest hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Mobile Sidebar Overlay -->
    <div 
      id="sidebar-overlay"
      class="lg:hidden fixed inset-0 bg-black/50 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
    ></div>

    <!-- Mobile Sidebar -->
    <aside 
      id="mobile-sidebar"
      class="lg:hidden fixed inset-0 bg-white z-50 transform -translate-x-full transition-transform duration-300 overflow-y-auto"
    >
      <!-- Close button header -->
      <div class="sticky top-0 bg-white border-b border-warm-200 px-4 py-3 flex items-center justify-between z-10">
        <a href="/" class="flex items-center gap-2">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-coral to-pink-400 flex items-center justify-center">
            <span class="text-white text-lg">🤰</span>
          </div>
          <div>
            <span class="font-display text-lg font-semibold text-forest">Pregnancy</span>
            <span class="text-sm text-gray-500 ml-1">Guide</span>
          </div>
        </a>
        <button 
          id="sidebar-close"
          class="p-2 rounded-lg hover:bg-warm-100 transition-colors"
          aria-label="Close menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-forest" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <Sidebar currentMonth={currentMonth} />
    </aside>

    <div class="flex min-h-screen pt-14 lg:pt-0">
      <!-- Desktop Sidebar -->
      <aside class="hidden lg:block w-80 bg-white border-r border-warm-200 flex-shrink-0 sticky top-0 h-screen overflow-y-auto" transition:persist>
        <Sidebar currentMonth={currentMonth} />
      </aside>

      <!-- Main Content -->
      <main class="flex-1 flex flex-col xl:flex-row" transition:animate="fade">
        <!-- Content Area -->
        <div class="flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto">
          <slot />
        </div>

        <!-- Right Image Section - Hidden on mobile/tablet, visible on xl+ -->
        <div class="hidden xl:flex w-96 flex-shrink-0 sticky top-0 h-screen items-center justify-center overflow-hidden" transition:persist>
          <!-- Background gradient -->
          <div class="absolute inset-0 bg-gradient-to-br from-blush via-warm-100 to-peach"></div>
          
          <!-- Decorative circles -->
          <div class="absolute top-10 right-10 w-32 h-32 rounded-full bg-coral/10 blur-2xl"></div>
          <div class="absolute bottom-20 left-5 w-40 h-40 rounded-full bg-warm-300/20 blur-3xl"></div>
          <div class="absolute top-1/3 left-10 w-24 h-24 rounded-full bg-pink-200/30 blur-xl"></div>
          
          <!-- Image container -->
          <div class="relative z-10 p-6">
            <div class="relative">
              <!-- Decorative frame -->
              <div class="absolute -inset-4 rounded-3xl bg-white/40 backdrop-blur-sm shadow-lg"></div>
              <div class="absolute -inset-2 rounded-2xl border-2 border-coral/20"></div>
              
              <!-- The illustration -->
              <img 
                src="/pregnancy-illustration.svg" 
                alt="Pregnancy illustration" 
                class="relative w-72 h-auto rounded-xl mix-blend-multiply opacity-90"
                style="filter: sepia(10%) saturate(110%) hue-rotate(-5deg);"
              />
            </div>
            
            <!-- Caption -->
            <p class="text-center mt-6 text-coral/70 font-display text-sm font-medium">
              Your pregnancy journey
            </p>
          </div>
        </div>
      </main>
    </div>

    <script>
      // Initialize menu functionality
      function initMenu() {
        const menuToggle = document.getElementById('menu-toggle');
        const sidebarClose = document.getElementById('sidebar-close');
        const mobileSidebar = document.getElementById('mobile-sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');

        function openMenu() {
          mobileSidebar?.classList.remove('-translate-x-full');
          sidebarOverlay?.classList.remove('opacity-0', 'pointer-events-none');
          menuIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }

        function closeMenu() {
          mobileSidebar?.classList.add('-translate-x-full');
          sidebarOverlay?.classList.add('opacity-0', 'pointer-events-none');
          menuIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
          document.body.style.overflow = '';
        }

        // Instantly close menu without animation (for View Transitions)
        function closeMenuInstant() {
          if (mobileSidebar) {
            mobileSidebar.style.transition = 'none';
            mobileSidebar.classList.add('-translate-x-full');
          }
          if (sidebarOverlay) {
            sidebarOverlay.style.transition = 'none';
            sidebarOverlay.classList.add('opacity-0', 'pointer-events-none');
          }
          menuIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
          document.body.style.overflow = '';
          
          // Re-enable transitions after a frame
          requestAnimationFrame(() => {
            if (mobileSidebar) mobileSidebar.style.transition = '';
            if (sidebarOverlay) sidebarOverlay.style.transition = '';
          });
        }

        menuToggle?.addEventListener('click', () => {
          const isOpen = !mobileSidebar?.classList.contains('-translate-x-full');
          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        });

        sidebarClose?.addEventListener('click', closeMenu);
        sidebarOverlay?.addEventListener('click', closeMenu);

        // Close menu on escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeMenu();
          }
        });

        // Store closeMenuInstant globally for View Transitions
        (window as any).__closeMenuInstant = closeMenuInstant;
      }

      // Run on initial load
      initMenu();

      // Close sidebar instantly before View Transition starts
      document.addEventListener('astro:before-preparation', () => {
        (window as any).__closeMenuInstant?.();
      });

      // Re-run after View Transitions navigation
      document.addEventListener('astro:after-swap', initMenu);
    </script>
  </body>
</html>
